# Copie este archivo como ".env" (en la misma carpeta frontend). Es opcional.
# No ponga contraseñas aquí: todo lo que empieza con VITE_ queda visible en el navegador.

# Dirección de la API. "/api" usa el proxy de Vite (recomendado: el navegador
# ve un solo sitio y las cookies de sesión funcionan sin configurar nada más).
VITE_API_URL=/api

# Adónde reenvía Vite las peticiones /api en desarrollo (el backend).
VITE_BACKEND_URL=http://localhost:3000
