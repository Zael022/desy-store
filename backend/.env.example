# Copie este archivo como ".env" (en la misma carpeta backend) y ponga sus datos reales.
# El archivo .env NO se sube a GitHub.

# Puerto donde escucha la API de Express
PORT=3000

# Datos de conexión a MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=escriba_aqui_su_contrasena_de_mysql
DB_NAME=inventario_bisuteria

# Único origen (dirección del frontend) que puede llamar a la API (CORS).
# Es la dirección que muestra Vite al ejecutar "npm run dev" en frontend.
CORS_ORIGIN=http://localhost:5173
