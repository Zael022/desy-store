# =====================================================================
# Variables del backend de Desy.
# Copie este archivo como ".env" (en la misma carpeta backend) y ponga sus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore) y NUNCA va en el frontend.
# Ningún valor de este ejemplo es una credencial real.
# =====================================================================

# ---------- General ----------
# development = su computadora (permite el modo consola). production = publicado.
NODE_ENV=development
# Puerto donde escucha la API de Express
PORT=3000
# Único origen (dirección del frontend) que puede llamar a la API con cookies (CORS).
CORS_ORIGIN=http://localhost:5173
# Dirección del frontend que va en los enlaces de los correos (recuperar contraseña, invitaciones).
FRONTEND_URL=http://localhost:5173
# Solo si publica la API detrás de un proxy (por ejemplo Render o Nginx): 1
# TRUST_PROXY=1

# ---------- MySQL 8 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Si la contraseña tiene # o espacios, póngala entre comillas: DB_PASSWORD="mi#clave"
DB_PASSWORD=escriba_aqui_su_contrasena_de_mysql
DB_NAME=inventario_bisuteria
# Base que usan las pruebas automáticas (npm test la BORRA y la vuelve a crear; debe contener "prueba").
DB_NAME_PRUEBAS=inventario_bisuteria_prueba

# ---------- Secretos ----------
# Secreto para guardar los códigos de verificación como HMAC-SHA256.
# Mínimo 32 caracteres al azar. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODIGOS_SECRETO=pegue_aqui_64_caracteres_generados_con_el_comando_de_arriba

# ---------- Sesiones ----------
# La sesión se cierra tras estos minutos sin actividad...
SESION_INACTIVIDAD_MINUTOS=30
# ...y siempre después de estas horas, aunque haya actividad.
SESION_ABSOLUTA_HORAS=8

# ---------- Modo consola (solo para desarrollo) ----------
# true = los códigos y enlaces se muestran en la consola del backend en vez de enviarse.
# Igual hay que escribir el código: NO se salta el segundo factor.
# Solo funciona con NODE_ENV=development; en production se ignora aunque diga true.
MFA_MODO_CONSOLA=false

# ---------- Correo (SMTP con Nodemailer) ----------
# Gmail: necesita la verificación en 2 pasos activa y una "contraseña de aplicación"
# (16 letras). La contraseña normal de Gmail NO funciona. Ver README, sección Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true solo si usa el puerto 465
SMTP_SECURE=false
SMTP_USER=su_correo@gmail.com
SMTP_PASS=contrasena_de_aplicacion_de_16_letras
SMTP_FROM="Desy <su_correo@gmail.com>"

# ---------- SMS (Twilio) ----------
# Datos de la consola de Twilio (Account Info). Con una cuenta de prueba (trial)
# solo se puede enviar SMS a números verificados en Twilio. Ver README, sección Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=escriba_aqui_su_auth_token
# Número que le da Twilio, en formato internacional, por ejemplo +15551234567
TWILIO_FROM_NUMBER=+15550000000

# ---------- Límites (opcionales; estos son los valores por defecto) ----------
# Códigos por hora para una misma cuenta y propósito (además, 60 s entre reenvíos)
CODIGOS_MAXIMO_POR_HORA=10
# Peticiones por IP en 15 minutos (login, códigos, enlaces) y en 60 minutos (recuperación)
LIMITE_LOGIN_POR_IP=20
LIMITE_CODIGOS_POR_IP=15
LIMITE_ENLACES_POR_IP=40
LIMITE_RECUPERACION_POR_IP=10

# ---------- Fotos de los productos (opcional) ----------
# Carpeta donde se guardan las fotos. Por defecto: backend/uploads/productos
# CARPETA_FOTOS=

# ---------- Primera dueña (opcional, solo para "npm run crear-duena") ----------
# Si los tres existen, el comando no pregunta. Bórrelos del .env al terminar.
# DUENA_NOMBRE=
# DUENA_CORREO=
# DUENA_CONTRASENA=
